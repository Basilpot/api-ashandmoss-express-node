generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

// ─── Auth / Users ────────────────────────────────────────────────────────────

model Admin {
  id        Int       @id @default(autoincrement())
  username  String    @unique
  email     String    @unique
  password  String
  role      AdminType @default(SUPPORT)
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  @@map("admin")
}

model User {
  id            Int        @id @default(autoincrement())
  role          String     @default("USER")
  email         String
  password      String
  phone         String?
  dateOfBirth   DateTime?
  emailVerified Boolean    @default(false)
  createdAt     DateTime   @default(now())
  updatedAt     DateTime   @updatedAt
  name          String
  image         String?
  username      String
  bio           String?
  meta          Json?
  Review        Review[]
  wishlists     Wishlist[]

  @@unique([email])
  @@unique([username])
  @@index([createdAt])
  @@map("user")
}

// ─── Catalog ─────────────────────────────────────────────────────────────────

model Category {
  id        String      @id @default(cuid())
  name      String
  slug      String      @unique
  image     String?
  sortOrder Int         @default(0)
  parentId  String?
  parent    Category?   @relation("CategoryTree", fields: [parentId], references: [id])
  children  Category[]  @relation("CategoryTree")
  products  Product[]
  createdAt DateTime    @default(now())
  updatedAt DateTime    @updatedAt

  @@index([parentId])
  @@map("category")
}

model Brand {
  id          Int       @id @default(autoincrement())
  name        String
  slug        String    @unique
  logo        String?
  isFeatured  Boolean   @default(false)
  sortOrder   Int       @default(0)
  products    Product[]
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  @@index([isFeatured])
  @@map("brand")
}

model Tag {
  id          String    @id @default(cuid())
  name        String
  slug        String    @unique
  description String?
  products    Product[] @relation("ProductToTag")
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  @@map("tag")
}

model Product {
  id              Int            @id @default(autoincrement())
  title           String
  slug            String         @unique
  description     String?
  price           Float?
  maxPrice        Float?
  compareAtPrice  Float?
  videoIntro      String?
  images          String[]       @default([])
  attributes      Json?
  faq             Json?
  metaTitle       String?
  metaDescription String?
  metaKeywords    String?
  metaRobots      String?
  sku             String?
  priceCurrency   String         @default("NPR")
  availability    String         @default("InStock")
  isFeatured      Boolean        @default(false)
  popularityScore Int            @default(0)
  views           Int            @default(0)
  status          ProductStatus  @default(DRAFT)
  categoryId      String?
  brandId         Int?
  category        Category?      @relation(fields: [categoryId], references: [id])
  brand           Brand?         @relation(fields: [brandId], references: [id])
  tags            Tag[]          @relation("ProductToTag")
  variants        Variant[]
  reviews         Review[]
  wishlists       Wishlist[]
  orderItems      OrderItem[]
  createdAt       DateTime       @default(now())
  updatedAt       DateTime       @updatedAt

  @@index([status])
  @@index([categoryId])
  @@index([brandId])
  @@index([isFeatured])
  @@index([popularityScore])
  @@map("product")
}

model Variant {
  id             Int          @id @default(autoincrement())
  productId      Int
  name           String
  sku            String?
  price          Decimal
  compareAtPrice Decimal?
  stock          Int          @default(0)
  image          String?
  sortOrder      Int          @default(0)
  product        Product      @relation(fields: [productId], references: [id], onDelete: Cascade)
  orderItems     OrderItem[]
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  @@index([productId])
  @@map("variant")
}

// ─── Commerce ────────────────────────────────────────────────────────────────

model Order {
  id          Int         @id @default(autoincrement())
  orderNumber String      @unique
  name        String
  email       String
  phone       String
  address     String?
  city        String?
  note        String?
  totalAmount Decimal
  currency    String      @default("NPR")
  status      OrderStatus @default(PENDING_PAYMENT)
  items       OrderItem[]
  payment     Payment?
  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt

  @@index([status])
  @@index([email])
  @@map("order")
}

model OrderItem {
  id          Int      @id @default(autoincrement())
  orderId     Int
  productId   Int
  productName String
  variantId   Int?
  variantName String?
  quantity    Int
  unitPrice   Decimal
  lineTotal   Decimal
  order       Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  product     Product  @relation(fields: [productId], references: [id])
  variant     Variant? @relation(fields: [variantId], references: [id])

  @@index([orderId])
  @@index([productId])
  @@map("order_item")
}

model Payment {
  id            Int             @id @default(autoincrement())
  orderId       Int             @unique
  amount        Decimal
  currency      String          @default("NPR")
  status        PaymentStatus   @default(PENDING)
  transactionId String?
  provider      PaymentProvider @default(CONNECTIPS)
  order         Order           @relation(fields: [orderId], references: [id], onDelete: Cascade)
  createdAt     DateTime        @default(now())
  updatedAt     DateTime        @updatedAt

  @@index([status])
  @@map("payment")
}

// ─── Engagement ──────────────────────────────────────────────────────────────

model Review {
  id        Int      @id @default(autoincrement())
  rating    Int
  text      String
  reviewerId Int
  productId Int
  createdAt DateTime @default(now())
  updatedAt DateTime @default(now())
  product   Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  reviewer  User     @relation(fields: [reviewerId], references: [id])

  @@index([productId])
  @@map("review")
}

model Wishlist {
  id        String   @id @default(cuid())
  itemId    Int      @unique
  userId    Int
  createdAt DateTime @default(now())
  updatedAt DateTime @default(now())
  item      Product  @relation(fields: [itemId], references: [id], onDelete: Cascade)
  user      User     @relation(fields: [userId], references: [id])

  @@unique([userId, itemId])
  @@index([userId])
  @@map("wishlist")
}

model Testimonial {
  id        String   @id @default(cuid())
  rating    Int?
  content   String
  author    String?
  media     String?
  createdAt DateTime @default(now())
  updatedAt DateTime @default(now())

  @@map("testimonial")
}

// ─── Content ─────────────────────────────────────────────────────────────────

model Author {
  id        String   @id @default(cuid())
  username  String
  name      String?
  email     String
  password  String
  bio       String?
  image     String?
  createdAt DateTime @default(now())
  updatedAt DateTime @default(now())
  blogs     Blog[]

  @@unique([username])
  @@unique([email])
  @@map("author")
}

model Blog {
  id              String            @id @default(cuid())
  title           String?
  slug            String
  content         String
  coverImage      String?
  tags            String?
  published       Boolean           @default(false)
  views           Int               @default(0)
  likes           Int               @default(0)
  publishedAt     DateTime?
  createdAt       DateTime          @default(now())
  updatedAt       DateTime          @updatedAt
  metaDescription String?
  metaTitle       String?
  inTrash         Boolean           @default(false)
  blogCategoryId  String?
  writerId        String?
  canonicalUrl    String?
  urlHistory      String[]          @default([])
  category        InfoPageCategory? @relation(fields: [blogCategoryId], references: [id])
  writer          Author?           @relation(fields: [writerId], references: [id])

  @@unique([slug])
  @@map("blog")
}

model InfoPageCategory {
  id             String     @id @default(cuid())
  categoryHandle String
  categoryName   String?
  createdAt      DateTime   @default(now())
  updatedAt      DateTime   @default(now())
  infoPages      InfoPage[]
  blogs          Blog[]

  @@unique([categoryHandle])
  @@map("info_page_category")
}

model InfoPage {
  id                 String            @id @default(cuid())
  title              String
  slug               String?
  content            String            @db.Text
  coverImage         String?
  metaTitle          String?
  metaDescription    String?
  published          Boolean           @default(true)
  createdAt          DateTime          @default(now())
  updatedAt          DateTime          @default(now())
  infoPageCategory   InfoPageCategory? @relation(fields: [infoPageCategoryId], references: [id])
  infoPageCategoryId String?

  @@unique([slug])
  @@map("info_page")
}

model NewsletterSubscriber {
  id             String    @id @default(cuid())
  email          String
  unsubSecret    String
  isActive       Boolean   @default(true)
  createdAt      DateTime  @default(now())
  unsubscribedAt DateTime?

  @@unique([email])
  @@unique([unsubSecret])
  @@map("newsletter_subscriber")
}

model Media {
  id          String   @id @default(cuid())
  url         String
  filename    String
  alt         String?
  caption     String?
  title       String?
  description String?
  mimeType    String?
  fileSize    Int?
  width       Int?
  height      Int?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([createdAt])
  @@map("media")
}

model Redirect {
  id        String  @id @default(cuid())
  from      String
  to        String
  permanent Boolean @default(false)

  @@unique([from])
  @@map("redirect")
}

// ─── Store settings (singleton) ──────────────────────────────────────────────

model StoreSetting {
  id          Int      @id @default(1)
  siteConfig  Json?
  menu        Json?
  footer      Json?
  sidebarMenu Json?
  updatedAt   DateTime @updatedAt

  @@map("store_setting")
}

// ─── Enums ───────────────────────────────────────────────────────────────────

enum ProductStatus {
  DRAFT
  PUBLISHED
}

enum AdminType {
  SUPERADMIN
  MODERATOR
  SUPPORT
}

enum OrderStatus {
  PENDING_PAYMENT
  CONFIRMED
  CANCELLED
  FAILED
  COMPLETED
}

enum PaymentStatus {
  PENDING
  SUCCESS
  FAILED
  REFUNDED
}

enum PaymentProvider {
  CONNECTIPS
}
